<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>uk.mathewcsims.kopia-verify</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/sh</string>
        <string>/Users/mathewcsims/self-hosted/kopia-mac/verify-backups.sh</string>
    </array>
    <!-- 06:00, deliberately AFTER all three hosts have finished:
           babel          01:00 kopia-server scheduler, 01:30 db-dumps.timer
           mathews-mac    02:00 kopia-mac/backup.sh
           slartibartfast 03:00 kopia-immich.timer
         Moved 04:00 -> 06:00 when the whole home directory became a source:
         backup.sh allows any one source up to 3 hours before killing it, so
         a worst-case Mac run can finish at 05:00. Verifying before the
         backup has finished would report the home source as stale and fire
         a false alarm every heavy night. This is a SEPARATE job
         from the backup rather than a step at the end of backup.sh, on
         purpose: if the backup wedges or is skipped entirely, the verifier
         still runs and is exactly what tells you so. Chaining it would mean
         the check dies with the thing it is checking. -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>6</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>
    <key>EnvironmentVariables</key>
    <dict>
        <key>HOME</key>
        <string>/Users/mathewcsims</string>
        <!-- Same load-bearing PATH reasoning as the backup agent: launchd
             gives a job a minimal PATH, not a login shell's. kopia lives in
             /opt/homebrew/bin, and python3 in /usr/bin. Without this the
             job dies immediately with "kopia: command not found" — and,
             being the thing that reports failures, it would fail silently. -->
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>
    <key>StandardOutPath</key>
    <string>/Users/mathewcsims/self-hosted/kopia-mac/verify-launchd.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/mathewcsims/self-hosted/kopia-mac/verify-launchd.log</string>
</dict>
</plist>
