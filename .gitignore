# ── Secrets ──────────────────────────────────────────────────────────────
# Every real .env and accounts.conf holds live credentials. Only their
# .example templates are ever tracked.
.env
**/.env
copyparty/cfg/accounts.conf
# local-only volume definitions and compose overrides — extra copyparty
# areas that deliberately stay out of the public repo entirely
copyparty/cfg/local-*.conf
copyparty/compose.override.yaml
kopia-mac/local-sources.txt
# Runtime scratch written by backup.sh / verify-backups.sh each night —
# the lock and its pid file, the recorded per-source failures, and the raw
# repository queries the verifier reasons over. Regenerated every run; none
# of it is state worth versioning.
kopia-mac/.backup.lock/
kopia-mac/.backup-failures
kopia-mac/.timed-out.*
kopia-mac/.snapshots.json
kopia-mac/.policies.json
kopia-mac/.verify-report
kopia-mac/.mirror.lock/
kopia-mac/.mirror-state

# ── Runtime data & databases ────────────────────────────────────────────
# This repo is infrastructure-as-code only — never the actual files,
# notes, sessions, or databases the apps generate while running.
copyparty/data/
copyparty/public/
copyparty/inbox/
# copyparty's own internal state: salts, sessions.db, shares.db, cert.pem, iphash
copyparty/cfg/copyparty/
memos-prospect-ukri-tus/data/
vikunja/db/
vikunja/files/
pi-reverse-proxy/caddy_data/
pi-reverse-proxy/caddy_config/
blog/db/
blog/content/
blog/traffic-analytics-data/
karakeep/data/
karakeep/meilisearch-data/
karakeep/meilisearch-data-old-1.11.1/
apprise/config/
uptime-kuma/data/
ntfy/data/
kopia-server/config/
kopia-server/cache/
kopia-server/logs/
kopia-server/tmp/
pi-reverse-proxy/logs/
owl/data/
bookstack/db/
bookstack/config/
forgejo/data/
wanderer/data/
# HedgeDoc (docs.mathewcsims.uk): its Postgres datadir, and the uploads
# directory holding every image pasted into a note. uploads/ is user data with
# no copy anywhere in git, so kopia-mac/backup.sh is its only backup — see
# docs/compose.yaml.
docs/pgdata/
docs/uploads/

# Paperless: the SQLite database, Tantivy full-text index and trained
# classifier. Deliberately local disk, never the NAS — see
# paperless/compose.yaml for why that split is not negotiable. The document
# blobs themselves are not here at all; they live on Eddie's Paperless share.
paperless/data/
paperless/redisdata/
# High-water mark for notify-failed-tasks.py — the highest task id already
# alerted on. Runtime state, regenerated on first run (which deliberately
# stays silent), and machine-specific.
paperless/.notify-state

# ── Tool-local / editor state ───────────────────────────────────────────
# Claude Code's own local session cache — unrelated to this project, and
# has been seen to cache credentials from earlier terminal commands.
# Exception: .claude/skills/ holds deliberately-authored, versioned tooling
# (e.g. the BookStack API skill) that should travel with the repo, not
# ephemeral session state — `.claude/*` (not `.claude/`) so the negation
# below can actually re-include it (git can't un-ignore a path whose parent
# directory is itself excluded).
.claude/*
!.claude/skills/

# ── Logs ─────────────────────────────────────────────────────────────────
autostart/*.log
*.log

# ── OS cruft ─────────────────────────────────────────────────────────────
.DS_Store
__pycache__/

# Consistent database dumps written before each Kopia run (see
# scripts/dump-databases.sh). Backed up to B2, never committed.
db-dumps/
