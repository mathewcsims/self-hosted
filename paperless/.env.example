# These fields live as a Proton Pass item ("Paperless", in the Self-Hosted
# Secrets vault) now, not a real .env file — see ../SETUP.md's "Secrets
# management" section. This file just documents which fields that item
# needs. Created via ../scripts/pass-create-paperless-secrets.sh.

# Django's session/cookie/token signing key.
PAPERLESS_SECRET_KEY=CHANGE_ME_GENERATE_WITH_OPENSSL

# Seeded into the database on first boot only. Changing these afterwards
# does nothing — from then on the account is managed inside the app.
PAPERLESS_ADMIN_USER=CHANGE_ME
PAPERLESS_ADMIN_PASSWORD=CHANGE_ME_GENERATE
PAPERLESS_ADMIN_MAIL=CHANGE_ME

# SMB credentials for the NAS share holding the document blobs.
#
# WHY THESE ARE HERE AND NOT JUST IN THE MAC'S KEYCHAIN: the CIFS mount is
# performed by the podman VM's kernel, not by macOS — see the long note in
# compose.yaml. The Keychain is not reachable from inside that VM, so these
# have to be available to pass-deploy.sh as environment variables. The
# Keychain copy still serves the Finder /Volumes mounts and should stay;
# these are a second copy for a different consumer, not a replacement.
#
# Deliberately a DEDICATED, LEAST-PRIVILEGE NAS account with access to the
# `paperless` share and nothing else — not `hog-user` (which can reach
# magrathea, Archive, Public and ProtonDriveBackup) and emphatically not
# `admin`. A credential that has to sit in an environment variable inside a
# container should be able to do as little as possible.
NAS_USER=CHANGE_ME
NAS_PASSWORD=CHANGE_ME
