# a login-gated admin dashboard for monitoring every other hostname in this
# repo. Caddy's reverse_proxy automatically upgrades WebSocket connections
# (Kuma's live dashboard runs over Socket.IO) — nothing extra needed here for
# that. Only the general per-IP rate limit applies: Kuma's login is
# Socket.IO-based, not a REST path, so the usual path-matched Caddy auth zone
# (see every other app above) doesn't apply here — 2FA in Kuma's own Settings
# is the compensating control instead. See ../uptime-kuma/compose.yaml.
status.mathewcsims.uk {
	import security_headers
	import general_ratelimit status
	reverse_proxy uptime-kuma:3001
}

# ── ntfy (running HERE on the Pi) ─────────────────────────────────────────
# Self-hosted push notification server, on trial alongside the Discord
# webhook (see ../ntfy/compose.yaml). Public, not LAN-gated: phones must
# receive pushes away from home — same reachability class as the Discord
# path it's trialling against. ntfy's own auth runs in default-deny mode
# (no anonymous read OR write), so this exposes a login wall, not an open
# relay; the general per-IP rate limit covers brute-force. Caddy upgrades
# WebSocket automatically (subscriber connections) — nothing extra needed.
ntfy.mathewcsims.uk {
	import security_headers
	import general_ratelimit ntfy
	reverse_proxy ntfy:80
}

# ── Tailscale webhook relay (running HERE on the Pi) ──────────────────────
# Clean public URL https://tailscale-relay.mathewcsims.uk. Deliberately
# PUBLIC, not LAN-gated — Tailscale's own cloud infrastructure delivers
# these webhooks from outside the tailnet entirely, so a LAN/tailnet-CGNAT
# gate would just block the real sender. HMAC-SHA256 signature verification
# inside the relay itself (Tailscale-Webhook-Signature header) is the real
# access control — see ../tailscale-webhook-relay/compose.yaml.
tailscale-relay.mathewcsims.uk {
	import security_headers
	import general_ratelimit tailscale_relay
	reverse_proxy tailscale-webhook-relay:8080
}

# ── Vikunja webhook relay (running HERE on the Pi, LAN-ONLY) ─────────────
# Clean public URL https://vikunja-relay.mathewcsims.uk, but only for LAN
# clients — same LAN-gate idiom as Apprise above. Bridges
# Vikunja's webhook payload shape to Apprise's /notify shape (see
# ../vikunja-webhook-relay/compose.yaml for why this exists at all — the two
# don't line up without something in between). The real access control is
# HMAC-SHA256 verification inside the relay itself (X-Vikunja-Signature),
# not this LAN-gate — but every other machine-to-machine app in this repo
# gets one anyway, so this does too, for consistency and defense in depth.
vikunja-relay.mathewcsims.uk {
	import security_headers
	import general_ratelimit vikunja_relay

	@lan remote_ip private_ranges 100.64.0.0/10 # + Tailscale CGNAT range
	handle @lan {
		reverse_proxy vikunja-webhook-relay:8080
	}
	# non-LAN (internet) clients: closed connection, nothing revealed
	handle {
		abort
	}
}

# ── Kopia backup server (running HERE on the Pi, LAN-ONLY) ───────────────
# Clean public URL https://backup.mathewcsims.uk, but only for LAN clients —
# same LAN-gate idiom as Apprise above, and for the same reason
# as every other admin surface in this repo: this can browse AND restore
# (and, if compromised, delete) every backup this stack has, so it never
# gets anywhere near the internet even with a login in front of it.
#
# Unlike every other backend in this Caddyfile, Kopia's server is HTTPS
# with a self-signed cert (its own web UI needs TLS to work correctly, and
# Kopia's own reverse-proxy docs recommend real TLS on the backend rather
# than its `--insecure` mode, which is a hidden/dev-only flag in Kopia's
# own source — not something to rely on in production). Caddy still
# terminates the real public-facing TLS; this is just the internal hop to
# a self-signed cert over the trusted `pi-shared` network, same reasoning
# as the mc37 router-admin block below.
backup.mathewcsims.uk {
	import security_headers
	import general_ratelimit backup

	@lan remote_ip private_ranges 100.64.0.0/10 # + Tailscale CGNAT range
	handle @lan {
		reverse_proxy https://kopia-server:51515 {
			transport http {
				tls_insecure_skip_verify # Kopia's own self-signed cert
			}
		}
	}
	# non-LAN (internet) clients: closed connection, nothing revealed
	handle {
		abort
	}
}

# ── DrayTek router admin (LAN-ONLY) ──────────────────────────────────────
# Values hardcoded on purpose: they're fixed, and an empty env var here would
# produce a keyless "{ }" block that crashes Caddy on startup.
# A PUBLIC A-record (mc37 → WAN IP) lets Caddy obtain a Let's Encrypt cert, but
# only private/LAN source IPs are allowed through — internet clients are
# dropped, so the router admin is never actually exposed. Pair with a DrayTek
# "LAN DNS" entry (mc37.mathewcsims.uk → 10.0.1.19) so LAN devices reach the Pi
# directly and their source IP is private (passing the check below).
mc37.mathewcsims.uk {
	@lan remote_ip private_ranges 100.64.0.0/10 # + Tailscale CGNAT range
	handle @lan {
		reverse_proxy https://10.0.1.1:8443 {
			transport http {
				tls_insecure_skip_verify # router uses a self-signed cert
			}
		}
	}
	# non-LAN (internet) clients: closed connection, nothing revealed
	handle {
		abort
	}
}

# ── BookStack (running on the Mac, LAN-ONLY) ─────────────────────────────
# Clean public URL https://author.mathewcsims.uk, but only for LAN/tailnet
# clients — same @lan/abort idiom as Apprise
# and mc37 above: a real public A-record lets Caddy obtain a Let's Encrypt
# cert (BookStack's own APP_URL always redirects to this hostname
# regardless of what Host header a request arrives with, so the cert has
# to be for this exact name), but only private-range or Tailscale-CGNAT
# source IPs ever get proxied through.
#
# No local-password rate-limit zone existed anywhere in this repo yet
# specifically for a plain username+password login form (every other app
# either has its own built-in rate limiting or uses SSO) — BookStack has
# neither, so this one targets its actual login POST directly, same
# defense-in-depth reasoning as Karakeep's NextAuth zone.
author.mathewcsims.uk {
	import security_headers

	@lan remote_ip private_ranges 100.64.0.0/10 # + Tailscale CGNAT range
	handle @lan {
		rate_limit {
			zone rl_bookstack {
				key {remote_host}
				events 300
				window 1m
			}
			zone rl_bookstack_login {
				match {
					method POST
					path /login
				}
				key {remote_host}
				events 10
				window 1m
			}
		}
		reverse_proxy http://{$MAC_IP}:6875
	}
	# non-LAN (internet) clients: closed connection, nothing revealed
	handle {
		abort
	}
}

# ── Paperless-ngx (running on the Mac, LAN-ONLY) ─────────────────────────
# Clean public URL https://paperless.mathewcsims.uk, but only for LAN/tailnet
# clients — same @lan/abort idiom as BookStack and Forgejo below.
#
# LAN-gating matters more here than for most: this instance holds personal
# medical documents, official correspondence and identity paperwork. Same
# priority as HealthLog further down, and for the same reason.
#
# Paperless serves its login form at /accounts/login/ (Django allauth).
# Rather than assume its built-in throttling is sufficient, this gets the
# same dedicated tighter zone as BookStack's and Forgejo's login POSTs —
# defence in depth on the one endpoint that accepts a password.
#
# PAPERLESS_URL in ../paperless/compose.yaml must match this hostname
# exactly: Django derives CSRF trusted origins and ALLOWED_HOSTS from it,
# so a mismatch surfaces as a 400 on every form submission, not as a
# routing error.
paperless.mathewcsims.uk {
	import security_headers

	@lan remote_ip private_ranges 100.64.0.0/10 # + Tailscale CGNAT range
	handle @lan {
		rate_limit {
			zone rl_paperless {
				key {remote_host}
				events 300
				window 1m
			}
			zone rl_paperless_login {
				match {
					method POST
					path /accounts/login/
				}
				key {remote_host}
				events 10
				window 1m
			}
		}
		reverse_proxy http://{$MAC_IP}:8000
	}
	# non-LAN (internet) clients: closed connection, nothing revealed
	handle {
		abort
	}
}

# ── Forgejo (running on the Mac, LAN-ONLY) ───────────────────────────────
# Clean public URL https://fj.mathewcsims.uk, but only for LAN/tailnet
# clients — same @lan/abort idiom as BookStack and Apprise above.
# Note this only covers the web UI; git-over-SSH (port 2222 on the Mac's
# LAN IP) is reached directly by clients, not proxied through Caddy at all
# — Caddy only ever speaks HTTP(S).
#
# No built-in login rate limiting confirmed either way for Forgejo's own
# `/user/login` form, so — same reasoning as BookStack's — this adds a
# dedicated tighter zone for it rather than assuming the app already
# covers it.
fj.mathewcsims.uk {
	import security_headers

	@lan remote_ip private_ranges 100.64.0.0/10 # + Tailscale CGNAT range
	handle @lan {
		rate_limit {
			zone rl_forgejo {
				key {remote_host}
				events 300
				window 1m
			}
			zone rl_forgejo_login {
				match {
					method POST
					path /user/login
				}
				key {remote_host}
				events 10
				window 1m
			}
		}
		reverse_proxy http://{$MAC_IP}:3300
	}
	# non-LAN (internet) clients: closed connection, nothing revealed
	handle {
		abort
	}
}

# ── HealthLog (running on the Mac) ───────────────────────────────────────
# Clean public URL https://healthlog.mathewcsims.uk. Personal health data
# (medications, vitals) — access control is the top priority for this app
# specifically, more so than anywhere else in this repo.
#
# Deployed 2026-07-26 with a temporary IP-allowlist (home public IP + LAN
# range) covering the setup window — HealthLog has no setup token, so
# whoever registers the very first account becomes admin, and the TLS cert
# issuance publishes this hostname to public Certificate Transparency logs
# within minutes regardless of DNS propagation. Removed here once Mathew
# completed passkey registration as the first (admin) user and disabled
# registration in HealthLog's own admin panel — the real, permanent access
# control from this point on is: registration closed + passkey-only login
# (no password fallback configured) + the rate limit below.
healthlog.mathewcsims.uk {
	import security_headers
	import general_ratelimit healthlog

	# HealthLog has no documented built-in rate limiting on its passkey/
	# auth endpoints (confirmed against its docs) — same defense-in-depth
	# reasoning as every other app's auth endpoint in this repo. Broad
	# path match since the exact WebAuthn route names aren't documented;
	# narrow this once confirmed live.
	rate_limit {
		zone rl_healthlog_auth {
			match {
				path /api/auth/*
			}
			key {remote_host}
			events 15
			window 1m
		}
	}

	# flush_interval -1 disables response buffering — required for
	# HealthLog's streaming "Coach" feature (documented upstream
	# requirement); explicit X-Forwarded-* headers match HealthLog's own
	# reference reverse-proxy example, even though these already match
	# Caddy's defaults.
	reverse_proxy http://{$MAC_IP}:3200 {
		header_up X-Forwarded-For {remote_host}
		header_up X-Forwarded-Proto {scheme}
		header_up Host {host}
		flush_interval -1
	}
}

# ── Wanderer (running on the Mac) ─────────────────────────────────────────
# Self-hosted GPS trail/ride log. The setup-time IP-allowlist (protecting
# against the first-registrant-becomes-admin race — PUBLIC_DISABLE_SIGNUP
# defaults open in upstream's own reference compose) was removed 2026-07-28
# once registration was confirmed closed: verified directly against
# data/pb_data/data.db (exactly one real user row, mat@mathewcsims.uk — the
# `_superusers` table's own bootstrap installer row doesn't count), not
# just trusted from the UI toggle. Real, permanent access control from here
# on: registration closed + the rate limit below.
wanderer.mathewcsims.uk {
	import security_headers
	import general_ratelimit wanderer

	# Wanderer has no documented built-in rate limiting on its own auth
	# endpoints (confirmed against its docs) — same defense-in-depth
	# reasoning as every other app's auth endpoint in this repo.
	rate_limit {
		zone rl_wanderer_auth {
			match {
				path /api/collections/users/auth-with-password /api/collections/users/records
			}
			key {remote_host}
			events 15
			window 1m
		}
	}

	reverse_proxy http://{$MAC_IP}:3400
}

# ── Immich (running on slartibartfast — the THIRD host, LAN-ONLY) ────────
# Clean public URL https://immich.mathewcsims.uk, but only for LAN/tailnet
# clients — same @lan/abort idiom as BookStack/Forgejo above. A
# real public A-record lets Caddy obtain a Let's Encrypt cert; only
# private-range or Tailscale-CGNAT source IPs are ever proxied through.
#
# This is the first app on a host that is NEITHER the Mac NOR the Pi, hence
# {$SLARTI_IP} (wired in via compose.yaml's environment: block, same as
# {$MAC_IP}). Pi-resident apps are proxied by container name over the
# `pi-shared` docker network — that can't work across hosts, so a
# published port + IP is the only option, exactly as for Mac apps.
#
# Photo library = the most sensitive data in this stack, and Immich's
# advisory history is substantial (see immich/compose.yaml's header), so it
# is deliberately never internet-reachable. Friends who need access get
# tailnet access instead of this being opened up. `photos.mathewcsims.uk`
# is deliberately NOT used here — it's reserved for a possible future
# public gallery-sharing tool, which would need the opposite posture.
immich.mathewcsims.uk {
	import security_headers

	@lan remote_ip private_ranges 100.64.0.0/10 # + Tailscale CGNAT range
	handle @lan {
		rate_limit {
			# 3000/min, NOT the 300/min every other app here uses — that
			# figure suits text apps and is far too tight for a photo
			# library. Hit immediately in real use (HTTP 429 in the web
			# UI): one timeline view fetches hundreds of thumbnails, and
			# scrolling or a mobile background upload fetches hundreds
			# more, so 300/min is exceeded by entirely normal browsing.
			# Still a real cap on a runaway client, and this host is
			# LAN/tailnet-gated anyway, so the general zone was never the
			# meaningful control here — the auth zone below is.
			zone rl_immich {
				key {remote_host}
				events 3000
				window 1m
			}
			# Immich has no documented brute-force protection of its own on
			# the login endpoint — same defense-in-depth reasoning as every
			# other app's auth endpoint in this repo. Method-scoped so it
			# can't touch the many authenticated GETs the mobile app makes.
			zone rl_immich_auth {
				match {
					method POST
					path /api/auth/login /api/auth/admin-sign-up
				}
				key {remote_host}
				events 10
				window 1m
			}
		}
		reverse_proxy http://{$SLARTI_IP}:2283
	}
	# non-LAN (internet) clients: closed connection, nothing revealed
	handle {
		abort
	}
}

# ── msims.link (running HERE on the Pi) ──────────────────────────────────
# Self-hosted URL shortener (chhoto-url). Bare root redirects to the real
# landing page (mathewcsims.uk) rather than showing the shortener's own
# app/login screen to random visitors — `path /` is an exact match (not a
# prefix), so it doesn't catch /admin/manage/ (the actual management UI)
# or real short-link slugs.
msims.link {
	import security_headers

	@bare_root path /
	redir @bare_root https://mathewcsims.uk 301

	import general_ratelimit msims_link

	# chhoto-url has no built-in brute-force protection on /api/login at
	# all — confirmed by reading its actual source (a failed attempt just
	# logs a warning, no lockout/delay). Same defense-in-depth pattern as
	# every other app's auth endpoint in this repo.
	rate_limit {
		zone rl_msims_link_auth {
			match {
				path /api/login
			}
			key {remote_host}
			events 10
			window 1m
		}
	}

	# An unknown/expired short link 404s from chhoto-url itself (confirmed
	# live) — this is a normal proxied response, not a Caddy-generated
	# error, so handle_errors doesn't see it; handle_response is the
	# mechanism that intercepts the upstream's own status code.
	reverse_proxy chhoto-url:4567 {
		@notfound status 404
		handle_response @notfound {
			root * /srv/msims-link-landing
			rewrite * /not-found.html
			file_server
		}
	}
}

# ── Pads / Etherpad (running on the Mac, LAN-ONLY) ───────────────────────
# Clean public URL https://pads.mathewcsims.uk, but only for LAN and tailnet
# clients — the LAN-gate idiom explained at the top of this file. Personal
# document-authoring space; see ../pads/.
#
# Unlike most LAN-gated apps here, this one has BOTH the gate and its own
# login, and that is deliberate rather than belt-and-braces for its own sake.
# The gate admits any device on the LAN or the tailnet, which is the right
# availability (family on the tailnet may be given accounts later) but is not
# an identity — it cannot tell one tailnet device from another. Etherpad's
# `requireAuthentication` supplies the identity, with bcrypt-hashed accounts
# via ep_hash_auth. See ../pads/settings.json.
#
# No path-matched auth rate-limit zone here, unlike every other app above.
# Etherpad authenticates with HTTP Basic Auth, so credentials ride on every
# request rather than being POSTed to a login route — there is no path to
# match on. The compensating controls are the general per-IP budget below and
# the fail2ban `caddy-abuse` jail (see ../pi-fail2ban/), which tails the
# access log this proxy already writes and so sees repeated 401s.
pads.mathewcsims.uk {
	import security_headers
	# Etherpad's editor is built from nested same-origin iframes (ace_outer
	# inside ace_inner). security_headers' blanket DENY blocks ALL framing,
	# including same-origin, so the browser replaces each editor frame with an
	# opaque-origin error document — and the parent's first access to it throws
	# `SecurityError: Blocked a frame with origin "https://pads.mathewcsims.uk"
	# from accessing a cross-origin frame`. The visible symptom is a pad stuck
	# on "Loading..." with Etherpad's generic red error box; the real cause is
	# only in the server log, which collects the client-side exception.
	#
	# Same fix as the Ghost block above, and the simple form works here for the
	# same reason: Etherpad sends no X-Frame-Options of its own (verified with
	# curl against :9001 directly — only Referrer-Policy), so there is no
	# upstream value for reverse_proxy's Add-not-Set copy to double up with,
	# and none of Owl's `header_down` complexity is needed.
	header X-Frame-Options "SAMEORIGIN"

	@lan remote_ip private_ranges 100.64.0.0/10 # + Tailscale CGNAT range
	handle @lan {
		# Hand-written rather than `import general_ratelimit pads` because
		# the snippet applies at block level, outside this handle — same
		# reason BookStack, Paperless, Forgejo and Immich all inline theirs.
		# 300/min is the standard budget; Etherpad is asset- and
		# socket-heavy, so raise it and record the observed figure here if
		# ordinary use ever trips it.
		rate_limit {
			zone rl_pads {
				key {remote_host}
				events 300
				window 1m
			}
		}
		reverse_proxy http://{$MAC_IP}:9001
	}
	# non-LAN (internet) clients: closed connection, nothing revealed
	handle {
		abort
	}
}

# ── Refuse every other hostname / bare-IP access ─────────────────────────
# Only the hostnames explicitly configured above are served. Any other
# SNI/Host — including a bare-IP scan of the public address — gets a closed
# connection, revealing nothing.
:80 {
	abort
}

:443 {
	tls internal
	abort
}
