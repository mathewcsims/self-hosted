# Global options
{
	# Let's Encrypt expiry notices. Set in ./.env
	email {$ACME_EMAIL}

	# caddy-ratelimit (see Dockerfile) isn't in Caddy's default directive
	# order, so it must be told where to run. "first" = every site block
	# checks its rate-limit zones before anything else (headers, rewrites,
	# proxying) — an over-limit request is rejected as cheaply as possible,
	# and never reaches copyparty/Memos/Vikunja/Nimbus at all.
	order rate_limit first

	# Persist the access log to a file on disk (bind-mounted out of the
	# container — see compose.yaml), not just ephemeral `docker logs`
	# output. Configuring the *default* logger here, once, applies to
	# every site block automatically — this is the prerequisite for the
	# fail2ban `caddy-abuse` jail (see ../pi-fail2ban/), which tails this
	# file from the host.
	log {
		output file /var/log/caddy/access.log {
			roll_size 10MiB
			roll_keep 5
			roll_keep_for 168h
		}
		format json
	}
}

# Reusable hardening headers — HSTS (force HTTPS on repeat visits),
# clickjacking and MIME-sniffing protection, conservative referrer leakage.
# Was Vikunja-only ("wasn't asked for elsewhere"); now applied everywhere
# per "harden Copyparty/Nimbus/Caddy in general" — it's free and every app
# here is either private or has an admin login worth protecting.
(security_headers) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
	}
}

# General-purpose per-site, per-IP request budget — coarse abuse/DoS
# protection, not a substitute for each app's own auth-specific limits
# (copyparty has --ban-pw/--ban-403 built in and enabled by default; Vikunja
# has VIKUNJA_RATELIMIT_*; Nimbus has none at all, see the @auth zone below).
# 300 req/min/IP is loose enough not to bother a real browsing session
# (page + assets + polling) while still capping a single source's blast
# radius. Zone name is parameterized per site (import ... <name>) so each
# site gets its own independent budget rather than sharing one global bucket.
(general_ratelimit) {
	rate_limit {
		zone rl_{args[0]} {
			key {remote_host}
			events 300
			window 1m
		}
	}
}

# ── copyparty (running on the Mac) ───────────────────────────────────────
# Clean public URL https://cp.mathewcsims.uk. Caddy gets the cert here (it
# owns 80/443) and proxies to plain-HTTP copyparty on the Mac. Caddy preserves
# the Host header and adds X-Forwarded-Proto=https, so copyparty generates
# correct https links and logs real client IPs (it trusts the Pi's private
# LAN IP by default).
{$CP_DOMAIN} {
	import security_headers
	import general_ratelimit cp
	reverse_proxy http://{$MAC_IP}:3923
}

# ── Memos (running on the Mac) ────────────────────────────────────────────
# Clean public URL https://prospect-ukri-tus.mathewcsims.uk. Same pattern as
# copyparty above: Caddy terminates TLS and proxies to plain-HTTP Memos on the
# Mac. Caddy's reverse_proxy sets X-Forwarded-For/-Proto/-Host by default —
# that, plus MEMOS_INSTANCE_URL set in the Mac's compose.yaml, is everything
# Memos needs to build correct URLs, including OAuth callback URLs, once SSO
# is configured in its admin UI. Nothing here needs to change for OAuth setup.
# The DOMAIN below is hardcoded (see the mc37 note): as a site block's key, an
# unset/empty env var there would produce a keyless "{ }" block that crashes
# Caddy on startup. $MAC_IP doesn't have that failure mode — it's only used as
# a value inside reverse_proxy, and it's already wired into compose.yaml's
# environment: block and proven working by the copyparty block above — so it's
# used here instead of a second hardcoded IP, for a single source of truth if
# the Mac's LAN IP ever changes.
prospect-ukri-tus.mathewcsims.uk {
	import security_headers
	import general_ratelimit memos

	# Memos has no rate-limiting, brute-force lockout, or CAPTCHA of its own
	# anywhere in its source (confirmed by reading it) — same gap class as
	# Nimbus. Registration is deliberately open here (this is for Prospect
	# members to self-signup), so unlike Nimbus this can't just be "strict
	# zone on all of /api/v1/auth/*" — a genuine new member still needs to
	# be able to sign up without hassle. Two separate, purpose-matched zones:
	#
	# Both zones match TWO path forms per action, not one — the web app
	# actually talks to the server over Connect-RPC
	# (/memos.api.v1.<Service>/<Method>), not the /api/v1/... REST-gateway
	# surface these zones originally matched only. Confirmed live: 25 rapid
	# POSTs to /memos.api.v1.AuthService/SignIn all reached the backend
	# with zero 429s while this gap existed — the REST path was never what
	# real traffic (or a real attacker) uses, so the "20/min" limit below
	# was not actually being enforced until this fix. Both surfaces are
	# live and reachable regardless of which one the current frontend
	# prefers, so both are matched for defense in depth.
	rate_limit {
		# Credential-stuffing against existing accounts: sign-in and token
		# refresh. 20/min/IP is well above any real user's need but caps
		# automated password-guessing.
		zone rl_memos_auth {
			match {
				path /api/v1/auth/signin /api/v1/auth/refresh /memos.api.v1.AuthService/SignIn /memos.api.v1.AuthService/RefreshToken
			}
			key {remote_host}
			events 20
			window 1m
		}
		# Registration spam/bot floods: POST /api/v1/users (REST) or
		# /memos.api.v1.UserService/CreateUser (Connect-RPC) is the signup
		# endpoint (also used for admin user-management, but only unauthed
		# POST is what an anonymous signup bot can hit). 5/min/IP is
		# generous for a real one-off signup, tight against scripted abuse.
		zone rl_memos_register {
			match {
				method POST
				path /api/v1/users /memos.api.v1.UserService/CreateUser
			}
			key {remote_host}
			events 5
			window 1m
		}
	}

	reverse_proxy http://{$MAC_IP}:5230
}

# ── Owl (Memos, running on the Mac) ────────────────────────────────────────
# Clean public URL https://owl.mathewcsims.uk. Same pattern as the Memos
# block above — a separate, unrelated Memos instance (personal notes, not
# Prospect), migrated from an unrelated ScaleTail Tailscale-sidecar
# deployment. Registration is closed here (personal instance, matching the
# Nimbus precedent), so only one rate-limit zone is needed — no signup zone,
# unlike prospect-ukri-tus.mathewcsims.uk above.
owl.mathewcsims.uk {
	# Wrapped in an explicit route{} block: without it, Caddyfile's adapter
	# reorders top-level directives by its own fixed precedence rather than
	# source order (confirmed live via `caddy adapt`).
	route {
		import general_ratelimit owl

		# Memos' own Go backend ALSO sets X-Frame-Options: DENY on every
		# response, including attachment files (confirmed by reading
		# server/router/fileserver/fileserver.go at the pinned version) —
		# that blocks ANY framing of an attachment, even same-origin, so
		# the document-viewer's PDF/HTML <iframe> (loaded from this same
		# page) got refused outright.
		#
		# Two earlier attempts at overriding this both failed, confirmed
		# live via a real browser fetch(): (1) a single unconditional
		# `header X-Frame-Options DENY` plus a later path-matched
		# `header ... SAMEORIGIN` override got reordered by Caddyfile's
		# adapter regardless of source position; (2) even with two fully
		# mutually-exclusive matchers (one always DENY, one always
		# SAMEORIGIN, only one ever able to match a given request) the
		# response STILL came back as the broken, doubled
		# `SAMEORIGIN, DENY`. Root cause: the `header` directive is
		# middleware that pre-sets a value on the response BEFORE
		# reverse_proxy runs — but reverse_proxy then copies the
		# upstream's own headers onto the response using Add, not Set, so
		# Memos' own DENY gets appended on top regardless of what a prior
		# `header` directive set. The fix has to happen AFTER the
		# upstream response is copied in, which is exactly what
		# reverse_proxy's own `header_down` sub-directive is for — see
		# the reverse_proxy block below.
		rate_limit {
			# Matches both the REST-gateway and Connect-RPC forms of the
			# same two endpoints — see the comment on the equivalent
			# Memos zone above for why both are needed (the web app
			# actually uses the Connect-RPC path, not the REST one this
			# used to match alone).
			zone rl_owl_auth {
				match {
					path /api/v1/auth/signin /api/v1/auth/refresh /memos.api.v1.AuthService/SignIn /memos.api.v1.AuthService/RefreshToken
				}
				key {remote_host}
				events 20
				window 1m
			}
		}

		# Document-viewer static bundle (owl/document-viewer/) — a
		# client-side script (injected via Memos' own additionalScript
		# hook) that lets attachments preview in-browser instead of
		# force-downloading. Served by a separate minimal Caddy sidecar
		# on the Mac, not by Memos itself (Memos has no mounted-static-
		# directory feature). handle_path strips the prefix before
		# proxying, so the sidecar's own Caddyfile stays a plain
		# `root * /srv; file_server` with no knowledge of this prefix.
		# Must come before the bare reverse_proxy below so it's matched
		# first.
		handle_path /document-viewer/* {
			reverse_proxy http://{$MAC_IP}:5233
		}

		# Attachment files: same security_headers set as everywhere else,
		# EXCEPT X-Frame-Options — that one is deliberately handled only
		# by header_down below (see the comment above), never by a plain
		# `header` directive, so there's no pre-set value for
		# reverse_proxy's upstream-header copy to double up with.
		@attachments path /file/*
		handle @attachments {
			header {
				Strict-Transport-Security "max-age=31536000; includeSubDomains"
				X-Content-Type-Options "nosniff"
				Referrer-Policy "strict-origin-when-cross-origin"
			}
			reverse_proxy http://{$MAC_IP}:5231 {
				# Runs after Memos' own response (including its DENY) is
				# already copied in, so this reliably replaces it —
				# confirmed live, unlike the `header` directive attempts
				# above.
				header_down X-Frame-Options "SAMEORIGIN"
			}
		}

		handle {
			import security_headers
			reverse_proxy http://{$MAC_IP}:5231
		}
	}
}

