<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>uk.mathewcsims.podman-watchdog</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/sh</string>
        <string>/Users/mathewcsims/self-hosted/podman-watchdog/run-watchdog.sh</string>
    </array>
    <!-- Every 2 minutes — faster than the Kuma monitor's own 150s
         interval/60s retry, so a missed VM heartbeat is never purely a
         scheduling-jitter false alarm. -->
    <key>StartInterval</key>
    <integer>120</integer>
    <key>RunAtLoad</key>
    <true/>

    <!-- LOAD-BEARING, and doubly so here. Same reason as
         autostart/uk.mathewcsims.podman-autostart.plist: launchd kills any
         process left in a job's process group when the job exits, and
         `podman machine start` leaves gvproxy and krunkit in exactly that
         group (they reparent to PID 1 but never setsid away).

         This job now RESTARTS the VM, not just watches it. Without this key
         that capability is worse than not having it: the watchdog would
         start the machine, alert "restarted automatically", exit, have
         launchd immediately kill the VM it just started, then repeat until
         MAX_RESTART_ATTEMPTS is exhausted — burning every attempt while
         reporting success each time, and finishing with the stack still
         down. Caught on review of the change that added the restart, before
         it ever ran against a real outage. -->
    <key>AbandonProcessGroup</key>
    <true/>

    <key>EnvironmentVariables</key>
    <dict>
        <key>HOME</key>
        <string>/Users/mathewcsims</string>
        <key>PATH</key>
        <string>/opt/podman/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>
    <key>StandardOutPath</key>
    <string>/Users/mathewcsims/podman-watchdog/launchd.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/mathewcsims/podman-watchdog/launchd.log</string>
</dict>
</plist>
