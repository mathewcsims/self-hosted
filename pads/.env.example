# Template only — there is NO real .env for this app.
#
# These values live as a "Pads" item in the "Self-Hosted Secrets" Proton Pass
# vault, and scripts/pass-deploy.sh exports them into the deploy process's
# environment at `podman compose up` time. Nothing is written to disk. This
# file exists purely to record which fields the Pass item must contain.
#
# Create the item once with:
#   ./scripts/pass-create-pads-secrets.sh
#
# Deploy with:
#   ./scripts/pass-deploy.sh pads
#
# Never `podman compose up -d` directly: PADS_ADMIN_HASH would resolve to an
# empty string, Etherpad would start with an admin account whose hash is
# blank, and the login would fail with nothing obviously wrong in the logs.

# bcrypt hash of the admin password, substituted into pads/settings.json by
# Etherpad at load time. MUST be $2a$ or $2b$ — a $2y$ hash (what htpasswd
# emits by default) is silently rejected by node's bcrypt and no login will
# ever succeed. The creation script handles this.
PADS_ADMIN_HASH=

# The plaintext admin password. Not consumed by the app — stored alongside the
# hash so you can actually log in. Username is "mathew" (set in settings.json).
PADS_ADMIN_PASSWORD=
