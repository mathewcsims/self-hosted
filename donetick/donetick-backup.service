[Unit]
Description=Dump Donetick's SQLite database and snapshot it to B2 (see backup.sh)
# Don't bother if the network isn't up — the timer's Persistent=true will
# catch up on the next boot instead. Same shape as kopia-immich.service.
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=%h/donetick/backup.sh
